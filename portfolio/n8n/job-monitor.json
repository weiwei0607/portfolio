    {
      "parameters": {
        "jsCode": "const items=$input.all();const d=new Date();let lines=['\\uD83E\\uDD16 今日AI精選盯缺 Top '+items.length+' ('+(d.getMonth()+1)+'/'+d.getDate()+')','','Gemini依你背景評分排序,挑5-8個精準投',''];\nitems.forEach((it,i)=>{const j=it.json;if(!j.title)return;lines.push((i+1)+'. ['+(j.line||'')+' '+(j.score||'')+'分] '+j.title);lines.push('   '+(j.company||'')+' | '+(j.location||'')+' — '+(j.why||''));lines.push('   '+(j.link||''));});\nreturn [{json:{text:lines.join('\\n')}}];"
