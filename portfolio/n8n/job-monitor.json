    {
      "parameters": {
        "jsCode": "const unescape=s=>(s||'').replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&#39;/g,\"'\").replace(/&quot;/g,'\"');\nconst getText=node=>{try{const j=$(node).first().json;return typeof j==='string'?j:(j.data||j.body||'');}catch(e){return '';}};\nfunction parseLI(h){const T=[...h.matchAll(/base-search-card__title\"[^>]*>\\s*([^<]+?)\\s*</g)].map(m=>unescape(m[1]));const C=[...h.matchAll(/base-search-card__subtitle\"[^>]*>\\s*(?:<a[^>]*>)?\\s*([^<]+?)\\s*</g)].map(m=>unescape(m[1]));const L=[...h.matchAll(/job-search-card__location\"[^>]*>\\s*([^<]+?)\\s*</g)].map(m=>unescape(m[1]));const K=[...h.matchAll(/href=\"(https:\\/\\/www\\.linkedin\\.com\\/jobs\\/view\\/[^\"?]+)/g)].map(m=>m[1]);const o=[];for(let i=0;i<T.length;i++)o.push({title:T[i]||'',company:C[i]||'',location:L[i]||'',link:K[i]||''});return o;}\nfunction parseWWR(xml){const items=[...xml.matchAll(/<item>([\\s\\S]*?)<\\/item>/g)].map(m=>m[1]);const o=[];for(const it of items){const g=t=>unescape(((it.match(new RegExp('<'+t+'>([\\\\s\\\\S]*?)<\\\\/'+t+'>'))||[])[1]||'').replace(/<!\\[CDATA\\[|\\]\\]>/g,'')).trim();const full=g('title');const p=full.split(':');o.push({title:(p[1]||full).trim(),company:(p[0]||'').trim(),location:g('region')||'Remote',link:g('link')});}return o;}\n\nfunction J(node){try{const t=getText(node);return JSON.parse(t);}catch(e){return null;}}\nfunction parseRemotive(n){const d=J(n);if(!d||!d.jobs)return [];return d.jobs.map(j=>({title:j.title||'',company:j.company_name||'',location:j.candidate_required_location||'Remote',link:j.url||''}));}\nfunction parseArbeitnow(n){const d=J(n);const a=(d&&d.data)||[];return a.map(j=>({title:j.title||'',company:j.company_name||'',location:(j.location||'')+(j.remote?' (Remote)':''),link:j.url||''}));}\nfunction parseHimalayas(n){const d=J(n);const a=(d&&(d.jobs||d.data))||[];return a.map(j=>({title:j.title||'',company:(j.companyName||j.company||''),location:(j.locationRestrictions&&j.locationRestrictions.join(', '))||'Remote',link:j.applicationLink||j.url||''}));}\nfunction parseAshby(n){const d=J(n);const a=(d&&d.jobs)||[];return a.map(j=>({title:j.title||'',company:'ElevenLabs',location:j.location||(j.isRemote?'Remote':''),link:j.jobUrl||j.applyUrl||''}));}\nfunction parseGreenhouse(n,co){const d=J(n);const a=(d&&d.jobs)||[];return a.map(j=>({title:j.title||'',company:co,location:(j.location&&j.location.name)||'',link:j.absolute_url||''}));}\nfunction parseLever(n,co){const d=J(n);const a=Array.isArray(d)?d:[];return a.map(j=>({title:j.text||'',company:co,location:(j.categories&&j.categories.location)||'',link:j.hostedUrl||''}));}\n\nlet all=[];['LI 產品經理','LI 運營','LI 成長行銷','LI AI產品'].forEach(n=>all=all.concat(parseLI(getText(n))));all=all.concat(parseWWR(unescape(getText('WWR 產品缺'))),parseWWR(unescape(getText('WWR 行銷缺'))));\nall=all.concat(parseRemotive('API Remotive'),parseArbeitnow('API Arbeitnow'),parseHimalayas('API Himalayas'),parseAshby('ATS ElevenLabs'),parseGreenhouse('ATS GitLab','GitLab'),parseLever('ATS Nium','Nium'),parseLever('ATS NinjaVan','Ninja Van'));\n// 先用寬鬆規則去雜訊+去重(把候選壓到 ~40 給 AI)\nconst kw=/product|growth|operations|marketing|content|\\bai\\b|associate|owner|analyst/i;\nconst junk=/translat|voice|data entry|transcri|caption|proofread|survey|annotat|appointment setter|telemarket/i;\nconst localLock=/india|nepal|pakistan|bangladesh|sri lanka|kazakhstan|\\buae\\b|united arab|dubai|abu dhabi|qatar|riyadh|saudi|delhi|mumbai|bengaluru|bangalore|hyderabad|chennai|kolkata|pune|indore|kochi|kerala|gujarat|karnataka|maharashtra|pradesh|jharkhand|chhattisgarh|rajasthan|noida|gurgaon|gurugram|ahmedabad|vadodara|bhilai|nirsa|almaty|lalitpur|kathmandu|colombo/i;\nconst global=/worldwide|anywhere|\\bglobal\\b|fully remote|remote[- ]?first/i;\nconst seen=new Set();const cand=[];\nfor(const j of all){const t=j.title||'';if(!t||!kw.test(t)||junk.test(t))continue;const key=(t+'@'+j.company).toLowerCase().replace(/\\s+/g,'');if(seen.has(key))continue;if(localLock.test(j.location)&&!global.test(j.location))continue;seen.add(key);cand.push({title:t,company:j.company,location:j.location,link:j.link});if(cand.length>=40)break;}\n// 組成給 Gemini 的請求(含韡寧背景 + 候選清單 + 要求回 JSON)\nconst profile='韡寧 Wei-Ning:台灣應屆(生醫工程學士+AI微學程),正職實績=PicWiz北美市場海外運營(內容策略/單月觸達51000);一年做20+個AI/LLM產品且大多上線;中英雙語TOEIC915;只能遠距(在台灣無海外工作簽,時區要APAC或非同步)。三條線:①運營/出海②AI產品經理③產品經理。要應屆友善(≤3年/junior/associate),排除資深(senior/lead/manager以上)與純工程/純數據。';\nconst list=cand.map((c,i)=>`${i}. ${c.title} | ${c.company} | ${c.location}`).join('\\n');\nconst prompt=`你是韡寧的求職助理。以下是今天抓到的遠距職缺候選。\\n\\n【韡寧背景】${profile}\\n\\n【候選清單】\\n${list}\\n\\n請依「韡寧實際能投且值得投」評分,挑出最值得投的最多20個。只輸出JSON陣列(不要markdown、不要多餘文字),格式:[{\"i\":候選編號,\"score\":0到10,\"line\":\"運營線/AI線/產品線\",\"why\":\"12字內為什麼\"}]。score低於5的不要放。注意:凡是綁定單一國家當地(尤其印度/南亞/中東)、需要當地工作權才能做的職缺,韡寧做不了,一律給0分不要選;只選真正跨國遠距(Worldwide/Anywhere/Fully Remote/全球/APAC不限國)或她有工作權地區(台灣)的。重要:只要職缺是全球任何地點皆可遠距,不論公司在歐洲/美洲/任何洲,韡寧都能做,請純依職務契合度(產品/運營/AI+應屆友善)給分,不要因為公司在歐洲或非APAC就扣分;時區只當小幅加減分。`;\nconst body=JSON.stringify({contents:[{parts:[{text:prompt}]}],generationConfig:{temperature:0.2,maxOutputTokens:2048,thinkingConfig:{thinkingBudget:0}}});\nreturn [{json:{geminiBody:body, candidates:cand}}];"
      },
