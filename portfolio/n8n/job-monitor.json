      "id": "h8000000-0000-0000-0000-000000000008",
      "name": "Gemini評分",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1060,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "const resp=$input.first().json;\nlet txt='';try{txt=resp.candidates[0].content.parts[0].text;}catch(e){return [{json:{error:'Gemini回應解析失敗',raw:JSON.stringify(resp).slice(0,300)}}];}\ntxt=txt.replace(/```json|```/g,'').trim();\nlet arr=[];try{arr=JSON.parse(txt);}catch(e){const m=txt.match(/\\[[\\s\\S]*\\]/);if(m){try{arr=JSON.parse(m[0]);}catch(e2){}}}\nif(!arr.length){const objs=txt.match(/\\{[^{}]*?\"score\"[^{}]*?\\}/g)||[];for(const o of objs){try{arr.push(JSON.parse(o));}catch(e){}}}\nconst cand=$('收集候選+組Prompt').first().json.candidates;\nconst out=[];for(const r of arr){const c=cand[r.i];if(!c)continue;out.push({json:{score:r.score,line:r.line,why:r.why,title:c.title,company:c.company,location:c.location,link:c.link}});}\nout.sort((a,b)=>b.json.score-a.json.score);\nreturn out.slice(0,8).length?out.slice(0,8):[{json:{note:'AI沒挑出符合的'}}];"
      },
