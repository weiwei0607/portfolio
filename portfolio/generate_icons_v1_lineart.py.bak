SVG_TEMPLATE = """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
    <rect width="120" height="120" rx="28" fill="{bg}"/>
    <g transform="translate(0, 4)" style="color: {fg};">
        {content}
    </g>
</svg>
"""

COLORS = [
    ("#f0fdfa", "#0d9488"),  # teal
    ("#eff6ff", "#2563eb"),  # blue
    ("#f5f3ff", "#7c3aed"),  # violet
    ("#fff7ed", "#ea580c"),  # orange
    ("#f0fdf4", "#16a34a"),  # green
    ("#fdf2f8", "#db2777"),  # pink
    ("#f8fafc", "#475569"),  # slate
]


def main():
    import os

    out_dir = os.path.join(os.path.dirname(__file__), "icons")
    os.makedirs(out_dir, exist_ok=True)

    for i, (name, content) in enumerate(ICONS.items()):
        bg, fg = COLORS[i % len(COLORS)]
        svg = SVG_TEMPLATE.format(bg=bg, fg=fg, content=content.strip())
        path = os.path.join(out_dir, f"{name}.svg")
        with open(path, "w", encoding="utf-8") as f:
            f.write(svg)
        print(f"Created {path}")


if __name__ == "__main__":
    main()
